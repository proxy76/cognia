# Server
COGNIA_PORT=8080
COGNIA_HOST=0.0.0.0
# Database (PostgreSQL)
COGNIA_DB_URL=jdbc:postgresql://localhost:5432/cognia
COGNIA_DB_DRIVER=org.postgresql.Driver
COGNIA_DB_USER=cognia
COGNIA_DB_PASSWORD=cognia
COGNIA_DB_MAX_POOL_SIZE=10

# JWT
COGNIA_JWT_SECRET=change-me-in-production
COGNIA_JWT_ISSUER=cognia-dev
COGNIA_JWT_EXPIRATION_MS=3600000
COGNIA_JWT_REFRESH_EXPIRATION_MS=2592000000

# Video
COGNIA_VIDEO_RAW_PATH=./data/videos/raw
COGNIA_VIDEO_PROCESSED_PATH=./data/videos/processed
COGNIA_VIDEO_THUMBNAIL_PATH=./data/videos/thumbnails
COGNIA_VIDEO_MAX_SIZE_MB=500

# OAuth
COGNIA_GOOGLE_CLIENT_ID=
COGNIA_APPLE_CLIENT_ID=
COGNIA_APPLE_TEAM_ID=
COGNIA_APPLE_KEY_ID=

# AI
COGNIA_ANTHROPIC_API_KEY=
COGNIA_ANTHROPIC_MODEL=claude-sonnet-4-20250514
COGNIA_ANTHROPIC_FAST_MODEL=claude-haiku-4-5-20251001
COGNIA_ANTHROPIC_MAX_TOKENS=1024

# Moderation Thresholds
COGNIA_MODERATION_AUTO_REJECT_THRESHOLD=0.95
COGNIA_MODERATION_REVIEW_THRESHOLD=0.7

# FFmpeg
COGNIA_FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
